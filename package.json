{
  "name": "node-solana-starter-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check:prod": "node scripts/deploy-check.mjs",
    "check:parc": "node scripts/deploy-fleet-check.mjs",
    "check:origine": "node scripts/origine-check.mjs",
    "check:soumission": "node scripts/pre-soumission.mjs",
    "check:fat": "node scripts/git-fat-report.mjs",
    "check:vapid": "node scripts/vapid-check.mjs",
    "x402:test": "node scripts/x402-pacts-server.mjs",
    "x402:api": "node scripts/x402-pacts-api.mjs",
    "x402:pay": "node scripts/x402-pacts-client.mjs",
    "setup:atas": "node scripts/setup-atas.mjs",
    "check:secret": "node scripts/secret-check.mjs",
    "check:helius": "node scripts/helius-key-audit.mjs",
    "check:history": "node scripts/history-secret-scan.mjs",
    "check:history:profond": "node scripts/history-secret-scan.mjs --profond",
    "test": "node --test scripts/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/build-guard.mjs",
    "check:build": "node scripts/build-guard.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "guard:push": "node scripts/git-guard.mjs --range origin/main..HEAD",
    "guard:rewrite": "node scripts/git-guard.mjs --rewrite",
    "guard:install": "node scripts/git-guard.mjs --install"
  },
